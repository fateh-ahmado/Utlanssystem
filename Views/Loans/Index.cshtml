@model IEnumerable<Utlanssystem.Models.Loan>

@{
    ViewData["Title"] = "Aktive lån";
}

<h1>Aktive lån</h1>

<table class="table">
    <thead>
        <tr>
            <th>Enhet</th>
            <th>Type</th>
            <th>Student</th>
            <th>Lånedato</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Device.Name</td>
                <td>@item.Device.DeviceType</td>
                <td>@item.Student.FirstName @item.Student.LastName</td>
                <td>@item.LoanDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Ingen aktive lån akkurat nå.</p>
}